# Copy this file to .env in the same directory (backend/.env) and fill in
# your own values. Never commit the real .env file.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for multimodal reasoning + web-grounded fact-checking.
ANALYSIS_MODEL=gemini-3.5-flash-lite

# Model used to generate the 4K shareable warning graphic.
IMAGE_MODEL=gemini-3-pro-image

# Soft, in-app monthly spend cap in Indian Rupees (see docs/ARCHITECTURE.md
# for why this is a soft guard, not a hard billing cap).
MONTHLY_BUDGET_INR=2500

# Used only to convert Gemini's USD pricing into INR for the local budget
# guard. Keep close to the live rate for an accurate estimate.
USD_TO_INR_RATE=90

# Reject uploads larger than this, to keep cost and latency predictable.
MAX_UPLOAD_MB=20
